// ============================================================
// Control de Asistencia NOM-037 — Schema v2.3 (SQLite dev)
// ============================================================
// ESTE ARCHIVO ES PARA DESARROLLO LOCAL (SQLite).
// Para producción, usar `schema.postgres.prisma` (PostgreSQL/Supabase).
//
// Cambiar entre los dos con:
//   ./scripts/switch-schema.sh postgres   ← producción
//   ./scripts/switch-schema.sh sqlite     ← dev local
//
// v2.3 (auditoría P0, 14-ago-2026):
//   - RT-P0.1: Modelo JornadaConfig (tope semanal por año, art. 61 LFT).
//   - RT-P0.5: Modelo ElectronicRecordAgreement (art. 132 XXXIV LFT — acuerdo).
//   - RT-P0.7: AuditLog con previousHash + recordHash (tamper-evident).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// MODELO: Company (singleton) — datos de la empresa
// ============================================================

model Company {
  id                 String   @id @default("singleton")
  razonSocial        String
  rfc                String
  registroPatronal   String?
  domicilioFiscal    String?
  telefono           String?
  email              String?
  logoUrl            String?
  representanteLegal String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================================
// MODELO: User
// ============================================================

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  name                   String
  role                   String    @default("EMPLOYEE") // GENERAL_ADMIN | SUCURSAL_ADMIN | SUPERVISOR | EMPLOYEE
  sucursalId             String?
  isActive               Boolean   @default(true)
  lastLoginAt            DateTime?
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  // --- MFA (Phase A — NextAuth + TOTP) ---
  mfaEnabled             Boolean   @default(false)
  mfaSecret              String? // TOTP secret (encrypted at rest via app-level AES)
  mfaBackupCodesHash     String? // JSON array of bcrypt hashes
  mfaEnrolledAt          DateTime?
  // --- LFPDPPP — Consentimiento del Aviso de Privacidad ---
  // privacyAcceptedAt: fecha en que el usuario aceptó el aviso de privacidad.
  // privacyAcceptedVersion: versión del aviso aceptada (ej. "1.0").
  // privacyAcceptedIp: IP desde la cual aceptó (evidencia para auditoría INAI).
  // Si privacyAcceptedAt es NULL → el middleware redirige a /legal/aviso-de-privacidad.
  // Si privacyAcceptedVersion != CURRENT_PRIVACY_VERSION → se vuelve a pedir consentimiento.
  privacyAcceptedAt      DateTime?
  privacyAcceptedVersion String?
  privacyAcceptedIp      String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  employee               Employee?
  auditLogs              AuditLog[]
  sucursal               Sucursal?          @relation("SucursalAdmins", fields: [sucursalId], references: [id])
  vacationsRequested     Vacation[]         @relation("VacationRequester")
  vacationsApproved      Vacation[]         @relation("VacationApprover")
  justificationsResolved AttendanceRecord[] @relation("JustificationResolver")
  attendanceCorrections  AttendanceRecord[] @relation("AttendanceCorrector")
  dynamicQRs             DynamicQR[]        @relation("DynamicQRCreator")
  privacyRequests        PrivacyRequest[]   @relation("PrivacyRequester")
  privacyResolved        PrivacyRequest[]   @relation("PrivacyRequestResolver")

  @@index([sucursalId])
  @@index([role])
  @@index([privacyAcceptedAt])
}

// ============================================================
// MODELO: PrivacyRequest — Derechos ARCO (LFPDPPP art. 29-32)
// ============================================================
// Solicitudes formales que el titular (empleado) hace al responsable
// (la empresa) para ejercer sus derechos:
//   ACCESS         — Conocer qué datos personales se tienen (art. 29).
//   RECTIFICATION  — Corregir datos inexactos (art. 30).
//   CANCELLATION   — Solicitar supresión / "derecho al olvido" (art. 31).
//                    ⚠️ CONFLICTO LEGISLATIVO: LFPDPPP art. 31 ordena suprimir,
//                    pero LFT art. 804 obliga a conservar registros de asistencia
//                    por 12 meses. Decisión de diseño: se anonimiza (se
//                    reemplazan identificadores por hashes irreversibles) y se
//                    conserva el registro probatorio sin identidad.
//   OPPOSITION     — Oponerse al tratamiento para ciertas finalidades (art. 32).
// ============================================================

model PrivacyRequest {
  id              String    @id @default(cuid())
  userId          String
  type            String // ACCESS | RECTIFICATION | CANCELLATION | OPPOSITION
  status          String    @default("PENDING") // PENDING | IN_PROGRESS | RESOLVED | REJECTED
  requestDetails  String? // JSON: { fields?: string[], reason?: string, targetData?: string }
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedById    String?

  user       User  @relation("PrivacyRequester", fields: [userId], references: [id])
  resolvedBy User? @relation("PrivacyRequestResolver", fields: [resolvedById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// MODELO: Sucursal
// ============================================================

model Sucursal {
  id                       String   @id @default(cuid())
  name                     String   @unique
  codigoLocal              String? // "261" para Matriz
  address                  String
  latitude                 Float?
  longitude                Float?
  geofenceRadiusMeters     Int      @default(150)
  enforceGeofence          Boolean  @default(false)
  mealToleranceMinutes     Int      @default(5)
  restToleranceMinutes     Int      @default(3)
  mealDurationMinutes      Int      @default(30)
  restDurationMinutes      Int      @default(15)
  checkoutToleranceMinutes Int      @default(10)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  employees         Employee[]
  admins            User[]             @relation("SucursalAdmins")
  attendanceRecords AttendanceRecord[]
}

// ============================================================
// MODELO: Employee
// ============================================================

model Employee {
  id                      String   @id @default(cuid())
  employeeNumber          String   @unique
  position                String
  department              String
  sucursalId              String
  userId                  String   @unique
  hireDate                DateTime @default(now())
  baseSalary              Float?
  vacationBalanceDays     Int      @default(12)
  // --- Saldos de vacaciones por año (LFT art. 76 — prima vacacional) ---
  // vacationBalanceDays: saldo "actual" que se descuenta al otorgar vacaciones
  //   (mantiene compatibilidad con la lógica existente en /api/vacations).
  // vacationBalanceDays2026: saldo correspondiente al año 2026.
  // vacationBalanceDays2027: saldo correspondiente al año 2027.
  // Los campos por año son informativos/de referencia para que el admin sepa
  // cuántos días le corresponden a cada empleado en cada año; el saldo activo
  // que se descuenta al otorgar vacaciones sigue siendo vacationBalanceDays.
  vacationBalanceDays2026 Int?
  vacationBalanceDays2027 Int?
  // --- RFC y CURP (identificadores fiscales y de identidad, art. 804 LFT) ---
  // RFC: Registro Federal de Contribuyentes (emite el SAT), 12-13 caracteres.
  // CURP: Clave Única de Registro de Población (emite el RENAPO), 18 caracteres.
  // Son OPCIONALES para no forzar la captura en empleados existentes que aún
  // no los tienen. Son ÚNICOS porque RFC y CURP no se reparten entre personas
  // físicas. Se guardan tal cual los captura el admin (mayúsculas normalmente),
  // sin normalización automática (trim/lowercase).
  rfc                     String?  @unique
  curp                    String?  @unique
  // --- NSS (Número de Seguro Social) — LSS art. 15, art. 804 fr. II LFT ---
  // 11 dígitos que emite el IMSS al inscribir al trabajador. OPCIONAL para no
  // bloquear la captura de empleados nuevos pendientes de registro ante el IMSS.
  // ÚNICO porque un NSS no se asigna a dos trabajadores. Se usa en el reporte
  // IMSS (/api/reports/imss-format) para reconciliar incapacidades con SUA/IDSE.
  // Formato esperado: 11 dígitos (sin letras ni guiones).
  nss                     String?  @unique
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                      User                       @relation(fields: [userId], references: [id])
  sucursal                  Sucursal                   @relation(fields: [sucursalId], references: [id])
  workSchedules             WorkSchedule[]
  attendanceRecords         AttendanceRecord[]
  vacations                 Vacation[]
  // --- RT-P0.5: Acuerdo formal de registro electrónico (art. 132 XXXIV LFT) ---
  // Relación 1:1. Si es NULL, el empleado NO ha aceptado el acuerdo de registro
  // electrónico de jornada y NO debería poder hacer check-in a partir del 1-ene-2027.
  electronicRecordAgreement ElectronicRecordAgreement?

  @@index([sucursalId])
  @@index([isActive])
}

// ============================================================
// MODELO: JornadaConfig — RT-P0.1 (art. 61 LFT, reforma DOF 27-dic-2024)
// ============================================================
// Tope de jornada semanal máxima por año, según el Transitorio del Decreto
// DOF 27-dic-2024 que reforma los arts. 60, 61, 62 y adiciona 62 Bis LFT:
//   2026 → 48 h
//   2027 → 46 h
//   2028 → 44 h
//   2029 → 42 h
//   2030+ → 40 h
// La jornada DIARIA máxima se mantiene en 8 h (diurna), 7 h (nocturna) o
// 7.5 h (mixta) según el art. 61 LFT — no se ve afectada por la reforma.
// Esta tabla es consultada por `validateWorkSchedules()` para rechazar horarios
// semanales que excedan el tope del año en curso.
// ============================================================

model JornadaConfig {
  year           Int      @id // ej. 2026, 2027, 2028, 2029, 2030
  maxWeeklyHours Int // 48, 46, 44, 42, 40
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================
// MODELO: ElectronicRecordAgreement — RT-P0.5 (art. 132 XXXIV LFT)
// ============================================================
// Acuerdo formal entre patrón y trabajador sobre el uso del sistema de registro
// electrónico de jornada. El art. 132 XXXIV LFT (reformado DOF 27-dic-2024)
// establece que el registro electrónico "hará prueba plena si se acredita que
// fue acordado entre la persona trabajadora y empleadora".
//
// Este acuerdo NO es equivalente al Aviso de Privacidad (LFPDPPP art. 16-17).
// Es un convenio laboral específico sobre el sistema de registro.
//
// Flujo:
//   1. Al primer inicio de sesión (o al desplegar la reforma), se presenta el
//      acuerdo al empleado.
//   2. El empleado acepta → se crea el registro con IP/UA/fecha como evidencia.
//   3. El middleware o el endpoint de check-in valida que exista un acuerdo
//      `isActive=true` antes de permitir el registro de asistencia.
//   4. Si el acuerdo se revoca (cambio de versión, baja del empleado), se
//      setea `revokedAt` y `isActive=false`, exigiendo re-aceptación.
// ============================================================

model ElectronicRecordAgreement {
  id               String    @id @default(cuid())
  employeeId       String    @unique // relación 1:1 con Employee
  agreedAt         DateTime  @default(now())
  agreedIp         String // IP desde la que aceptó (evidencia probatoria)
  agreedUserAgent  String // User-Agent del navegador/dispositivo
  agreementVersion String // ej. "1.0" — permite forzar re-aceptación al incrementar
  documentHash     String // sha256 del texto del acuerdo aceptado
  documentUrl      String? // URL del PDF del acuerdo (opcional, para descarga)
  isActive         Boolean   @default(true) // false si fue revocado o reemplazado
  revokedAt        DateTime? // fecha de revocación (si aplica)
  revokedReason    String? // motivo de revocación

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([isActive])
  @@index([agreementVersion])
}

// ============================================================
// MODELO: WorkSchedule
// ============================================================

model WorkSchedule {
  id               String   @id @default(cuid())
  employeeId       String
  dayOfWeek        Int // 0=domingo ... 6=sábado
  startTime        String // "HH:mm"
  endTime          String // "HH:mm"
  toleranceMinutes Int      @default(10)
  isWeeklyRest     Boolean  @default(false)
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
}

// ============================================================
// MODELO: AttendanceRecord (INMUTABLE — NOM-037)
// ============================================================

model AttendanceRecord {
  id                        String    @id @default(cuid())
  employeeId                String
  sucursalId                String
  date                      DateTime
  checkInTime               DateTime?
  checkInLat                Float?
  checkInLong               Float?
  checkInMethod             String?
  checkInIp                 String?
  checkInUserAgent          String?
  checkOutTime              DateTime?
  checkOutLat               Float?
  checkOutLong              Float?
  checkOutMethod            String?
  checkOutIp                String?
  checkOutUserAgent         String?
  mealStart                 DateTime?
  mealEnd                   DateTime?
  mealDurationMinutes       Int?
  mealExceeded              Boolean   @default(false)
  restStart                 DateTime?
  restEnd                   DateTime?
  restDurationMinutes       Int?
  restExceeded              Boolean   @default(false)
  status                    String    @default("PRESENT") // PRESENT|ABSENT|LATE|EARLY_LEAVE
  workedMinutes             Int?
  overtimeMinutes           Int? // total de minutos extra (legacy/agregado)
  // --- Reforma LFT 2027 (art. 66 y 68) — distinguir dobles vs triples ---
  // Primeras 9h/semana (2027) → doble. Excedente → triple. Tope diario: 4h.
  overtimeDoubleMinutes     Int? // minutos extra pagados al DOBLE (art. 66)
  overtimeTripleMinutes     Int? // minutos extra pagados al TRIPLE (art. 68, excedente semanal)
  overtimeWeeklyAccumulated Int? // acumulado semanal previo al registro (para tope)
  // --- Prima por descanso trabajado (art. 73 LFT) ---
  // Si el empleado labora en su día de descanso semanal, se paga con prima del 100%
  // (salario doble por el día completo). No se considera overtime (art. 66/68).
  isRestDayWorked           Boolean   @default(false) // true si la fecha del registro es día de descanso del empleado
  restDayWorkedMinutes      Int? // minutos trabajados en día de descanso (jornada completa, no overtime)
  restDayPremiumMinutes     Int? // prima del 100% adicional (art. 73 LFT) = restDayWorkedMinutes
  isSunday                  Boolean   @default(false) // true si la fecha cae en domingo (para prima dominical art. 71)
  // --- Jornada nocturna / mixta (art. 60 y 61 LFT) ---
  // Clasificación automática al check-out según los minutos trabajados en
  // horario nocturno (20:00-06:00). Para nómina: si es NOCTURNA o MIXTA,
  // aplica prima nocturna del 25% sobre las horas diurnas (art. 61 + jurisprudencia).
  shiftType                 String? // "DIURNA" | "NOCTURNA" | "MIXTA" (art. 60 LFT)
  nightMinutes              Int? // minutos trabajados en horario nocturno (20:00-06:00)
  notes                     String?
  justification             String?
  justificationStatus       String? // PENDING / APPROVED / REJECTED
  justificationResolvedById String?
  // --- Inmutabilidad (reforma LFT art. 132 XXXIV — trazabilidad probatoria) ---
  isLocked                  Boolean   @default(true)
  originalCheckInTime       DateTime? // valor original no sobreescribible
  originalCheckOutTime      DateTime? // valor original no sobreescribible
  correctionReason          String? // motivo de la corrección (si isLocked=false)
  correctedById             String? // quién corrigió
  correctedAt               DateTime? // cuándo corrigió
  // --- Prueba plena (art. 132 XXXIV: "hará prueba plena si fue acordado") ---
  employeeSignedAt          DateTime? // fecha en que el empleado aceptó el registro
  employeeSignatureHash     String? // hash del contenido firmado (HMAC)
  employeeSignedIp          String? // IP desde la que firmó
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  employee              Employee @relation(fields: [employeeId], references: [id])
  sucursal              Sucursal @relation(fields: [sucursalId], references: [id])
  justificationResolver User?    @relation("JustificationResolver", fields: [justificationResolvedById], references: [id])
  correctedBy           User?    @relation("AttendanceCorrector", fields: [correctedById], references: [id])

  @@unique([employeeId, date])
  @@index([sucursalId, date])
  @@index([date])
  @@index([status])
}

// ============================================================
// MODELO: Vacation
// ============================================================

model Vacation {
  id              String    @id @default(cuid())
  employeeId      String
  // VACACIONES|PERMISO|INCAPACIDAD|MATERNIDAD|RIESGO_TRABAJO|PATERNIDAD|OTRO
  // RIESGO_TRABAJO: incapacidad por accidente/enfermedad de trabajo (LSS art. 41, 51).
  //                Se reporta al IMSS por separado (ST-7) y se refleja en SUA.
  type            String    @default("VACACIONES")
  startDate       DateTime
  endDate         DateTime
  days            Int
  reason          String?
  status          String    @default("PENDING") // PENDING|APPROVED|REJECTED|CANCELLED
  requestedById   String
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // --- Folio IMSS — LSS art. 15 (incapacidades y maternidad) ---
  // Folio que emite el IMSS al tramitar la incapacidad (ST-3 / ST-7 / SV-CAE).
  // OPCIONAL al crear la solicitud (el IMSS lo asigna después); obligatorio
  // exhibirlo ante una inspección. Se usa en /api/reports/imss-format para
  // reconciliar con SUA/IDSE. Solo aplica para type IN ('INCAPACIDAD',
  // 'MATERNIDAD', 'RIESGO_TRABAJO').
  folioIMSS String?

  // --- Nuevos campos: permisos parciales y otorgamiento directo por admin ---
  // grantMode: EMPLOYEE_REQUEST (solicitud del empleado, queda PENDING)
  //            ADMIN_GRANTED     (otorgado directamente por admin, nace APPROVED)
  grantMode    String    @default("EMPLOYEE_REQUEST")
  // isPartial: true = permiso por horas dentro de un día (no descuenta saldo).
  isPartial    Boolean   @default(false)
  startTime    DateTime? // hora de salida (permiso parcial)
  endTime      DateTime? // hora de regreso opcional (permiso parcial)
  partialHours Int? // duración en horas (calculada o ingresada)

  employee    Employee @relation(fields: [employeeId], references: [id])
  requestedBy User     @relation("VacationRequester", fields: [requestedById], references: [id])
  approvedBy  User?    @relation("VacationApprover", fields: [approvedById], references: [id])

  @@index([employeeId, startDate])
  @@index([status])
  @@index([startDate, endDate])
}

// ============================================================
// MODELO: Holiday — días feriados
// ============================================================

model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @unique
  name        String
  description String?
  isOfficial  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================================
// MODELO: AuditLog — RT-P0.7 (tamper-evident hash chaining)
// ============================================================
// Bitácora de auditoría con encadenamiento de hashes para hacerla
// tamper-evident (art. 132 XXXIV LFT — prueba plena ante pericial).
//
// Mecanismo:
//   - Al insertar un registro, se obtiene el `recordHash` del último AuditLog
//     insertado (ORDER BY createdAt DESC LIMIT 1) y se usa como `previousHash`.
//   - Se calcula `recordHash = sha256(previousHash + action + entityType +
//     entityId + sucursalId + userId + createdAt + details)`.
//   - El endpoint `GET /api/audit/verify` recorre la cadena y reporta rupturas:
//     cualquier modificación manual de un registro en la DB se detecta porque
//     el `recordHash` recalculado no coincide con el almacenado.
//
// Nota: los campos son `String?` (nullable) para no romper los registros
// existentes previos a esta migración. Los registros nuevos siempre tendrán
// hash; los antiguos se consideran "pre-chain" y se excluyen de la verificación.
// ============================================================

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  entityType   String
  entityId     String?
  sucursalId   String?
  ipAddress    String?
  userAgent    String?
  details      String? // JSON string
  // --- RT-P0.7: Hash chaining (tamper-evident audit log) ---
  previousHash String? // hash del registro anterior en la cadena (null para el primero o pre-chain)
  recordHash   String? // sha256(previousHash + campos de este registro)
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sucursalId])
  @@index([createdAt])
  @@index([action])
  @@index([recordHash])
}

// ============================================================
// MODELO: DynamicQR
// ============================================================

model DynamicQR {
  id          String   @id @default(cuid())
  code        String   @unique
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("DynamicQRCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}
